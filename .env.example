# Local MariaDB/MySQL or TiDB Cloud Serverless.
# TiDB: mysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/folio_english
# (TLS is switched on automatically for *.tidbcloud.com hosts.)
DATABASE_URL="mysql://root:password@localhost:3306/folio_english"

# Protects /api/ingest. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="change-me"
